        .btn-nav {
            display: inline-block;
            padding: 10px 20px;
            background-color: #0284c7;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            border-radius: 5px;
            transition: background-color 0.2s ease;
        }

        .btn-nav:hover {
            background-color: #0369a1;
        }

        .btn-home {
            background-color: #1e293b;
        }

        .btn-home:hover {
            background-color: #334155;
        }

        @media print {
            header, .page-nav {
