                    <p>Computer Networks</p>
                </div>
                <div class="module-card">
                    <h4>CMPG 321</h4>
                    <p>Advanced Databases</p>
                </div>
                <div class="module-card">
                    <h4>CMPG 322</h4>
                    <p>Decision Support Systems 2</p>
                </div>
                <div class="module-card">
                    <h4>CMPG 323</h4>
