                <span class="skill-pill">Complex SQL Querying</span>
            </div>

            <div class="category-title">Optimization & Decision Support</div>
            <div class="skills-grid">
                <span class="skill-pill">Linear Programming (MILP)</span>
                <span class="skill-pill">Mathematical Optimization (Elytica)</span>
                <span class="skill-pill">Decision Support Systems (DSS)</span>
                <span class="skill-pill">Resource Allocation Modeling</span>
            </div>

            <div class="category-title">Tools & Development Environments</div>
            <div class="skills-grid">
                <span class="skill-pill">Notepad++</span>
                <span class="skill-pill">Code::Blocks</span>
                <span class="skill-pill">BlueJ</span>
                <span class="skill-pill">IDLE (Python)</span>
                <span class="skill-pill">Delphi</span>
                <span class="skill-pill">Git & GitHub</span>
                <span class="skill-pill">Visual Studio / VS Code</span>
                <span class="skill-pill">SQL Server Management Studio</span>
            </div>

            <div class="category-title">Academic & Interpersonal Strengths</div>
            <div class="skills-grid">
                <span class="skill-pill">Academic Tutoring & Mentorship</span>
                <span class="skill-pill">Code Reviewing & Feedback</span>
                <span class="skill-pill">Problem Solving & Debugging</span>
                <span class="skill-pill">Technical Communication</span>
                <span class="skill-pill">Team Collaboration</span>
            </div>
        </div>

        <div class="page-nav">
            <a href="experience.html" class="btn-nav">&larr; Previous: Experience</a>
            <a href="projects.html" class="btn-nav">Next: Projects &rarr;</a>
        </div>

    </div>

</body>
</html>
